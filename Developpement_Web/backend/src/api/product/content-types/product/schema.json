{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Produit",
    "description": "Produits de la boutique de vêtements biodégradables"
  },
  "options": {
    "draftAndPublish": true,
    "i18n": true
  },
  "attributes": {
    "nom": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "prix": {
      "type": "decimal",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "eco_score": {
      "type": "enumeration",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "temps_biodegradation": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "etapes_tracabilite": {
      "type": "component",
      "repeatable": true,
      "component": "tracabilite.etape"
    }
  }
}
